{
  "name": "core",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "-----BUILD-----": "",
    "build": "concurrently \"yarn build:client\" \"yarn build:server\" \"yarn build:web\"",
    "build:client": "node --es-module-specifier-resolution=node scripts/client",
    "build:server": "node --es-module-specifier-resolution=node scripts/server",
    "build:web": "cd web && yarn install && yarn build",
    "postinstall": "yarn build",
    "-----DEV-----": "",
    "dev": "concurrently \"yarn dev:client\" \"yarn dev:server\" \"yarn dev:web\" \"yarn tsc\" -c \"green.bold,cyan.bold\"",
    "dev:client": "node --es-module-specifier-resolution=node scripts/client --dev",
    "dev:server": "node --es-module-specifier-resolution=node scripts/server --dev",
    "dev:web": "cd web && yarn dev",
    "-----TSC-----": "",
    "tsc": "concurrently \"yarn tsc:client\" \"yarn tsc:server\" -c \"green.bold,cyan.bold\"",
    "tsc:client": "cd game/client && npx tsc -w",
    "tsc:server": "cd game/server && npx tsc -w"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@citizenfx/client": "latest",
    "@citizenfx/server": "latest",
    "@types/node": "^22.2.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.19.0",
    "javascript-obfuscator": "^4.1.1",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@citizenfx/three": "^0.100.0",
    "@overextended/ox_lib": "3.29.0",
    "@types/luxon": "^3.4.2",
    "luxon": "^3.6.0"
  }
}
